# OpenAI: transcription (whisper-1) and clip selection. If unset, OPENAI_API_KEY is used,
# including from content-factory/.env, so the shared key is enough.
SHORTS_OPENAI_API_KEY=
# ElevenLabs Scribe: needed only with SHORTS_TRANSCRIBER=elevenlabs.
SHORTS_ELEVENLABS_API_KEY=

# openai = whisper-1 (OpenAI shuts it down 2027-02-26), elevenlabs = Scribe v2
SHORTS_TRANSCRIBER=openai
SHORTS_SELECT_MODEL=gpt-6.1-sol

# Empty = ffmpeg from PATH, else the binary bundled with imageio-ffmpeg.
SHORTS_FFMPEG_BIN=
SHORTS_SUBTITLE_FONT=Arial
SHORTS_SUBTITLE_SIZE=84